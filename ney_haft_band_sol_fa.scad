/*
=========================================================
 نی هفت‌بند ایرانی — نسخهٔ ۴ (کوک سل)
 ساز ماژولار چاپ سه‌بعدی در هفت قطعه

 کوک:      سل (G)
 واحد:     میلی‌متر
 مجوز:     MIT (فایل LICENSE را ببینید)

 کوک نهایی نیازمند تست فیزیکی است.
 موقعیت سوراخ‌ها بر اساس نسبت‌های آکوستیکی محاسبه شده
 و ممکن است پس از چاپ نیاز به تنظیم جزئی داشته باشد.
=========================================================
*/

// کیفیت دایره‌ها. عدد بیشتر = منحنی نرم‌تر ولی رندر کندتر.
// ۱۰۰ برای کارهای معمول مناسب است؛ اگر رندر کند شد به ۵۰ تا ۶۰ کاهش دهید.
$fn = 100;


// =======================================================
// ۱. ابعاد کلی ساز
// =======================================================

// طول کل ساز به میلی‌متر.
// مثال: ۵۴۰ میلی‌متر = ۵۴ سانتی‌متر، طول استاندارد کوک سل.
// برای کوک‌های پایین‌تر (مثلاً فا) این عدد را افزایش دهید (مثلاً ۶۰۰).
total_length = 540;

// تعداد قطعات چاپی.
// مثال: ۷ یعنی ساز به ۷ بخش جدا تقسیم می‌شود.
// اگر قطعات بلندتر و تعداد کمتر می‌خواهید، این را کم کنید (مثلاً ۵).
number_of_parts = 7;

// قطر بیرونی لوله به میلی‌متر.
// مثال: ۲۲ میلی‌متر. محدودهٔ استاندارد نی: ۲۰ تا ۲۳ میلی‌متر.
outer_diameter = 22;

// قطر داخلی لوله به میلی‌متر.
// مثال: ۱۶ میلی‌متر. ضخامت دیواره = (۲۲-۱۶)/۲ = ۳ میلی‌متر.
// قطر داخلی کمتر (مثلاً ۱۴) → صدای روشن‌تر.
// قطر داخلی بیشتر (مثلاً ۱۸) → صدای بم‌تر و گرم‌تر.
inner_diameter = 16;

// طول هر قطعه (خودکار محاسبه می‌شود).
// مثال: ۵۴۰ / ۷ ≈ ۷۷.۱۴ میلی‌متر.
part_length = total_length / number_of_parts;

// شعاع بیرونی و داخلی (برای محاسبات داخلی کد).
ro = outer_diameter / 2;
ri = inner_diameter / 2;

// ضخامت دیواره به میلی‌متر.
wall = ro - ri;


// =======================================================
// ۲. گره‌های داخلی بامبو
// =======================================================

// قطر حفرهٔ باریک در محل گره.
// مثال: ۱۲.۵ میلی‌متر — حفره در محل گره از ۱۶ به ۱۲.۵ تنگ می‌شود.
// این کار اثر گره طبیعی بامبو را شبیه‌سازی می‌کند و روی رنگ صدا اثر دارد.
band_bore_diameter = 12.5;

// عرض قسمت باریک گره.
// مثال: ۵ میلی‌متر.
band_width = 5;

// طول شیب در هر طرف گره.
// مثال: ۳ میلی‌متر در هر طرف. مجموع طول گره = ۳+۵+۳ = ۱۱ میلی‌متر.
band_taper_length = 3;

// موقعیت گره‌ها از دهانه (z=0).
// مهم: هر گره (با شیب‌هایش) باید کاملاً داخل یک قطعه باشد
// و با هیچ سوراخی تداخل نداشته باشد. مقادیر زیر از پیش تنظیم شده‌اند:
// - ۳۵ و ۸۹: بدون مشکل
// - ۱۹۵: از ۱۸۹ جابه‌جا شد تا با سوراخ ۱۸۵ تداخل نکند
// - ۲۴۰: از ۲۴۳ جابه‌جا شد تا با سوراخ ۲۵۵ تداخل نکند
band_positions = [
    35,
    89,
    195,
    240,
    343,
    397,
    497
];


// =======================================================
// ۳. اتصالات نری و مادگی
// =======================================================

// طول قسمت نری که داخل قطعهٔ بعدی فرو می‌رود.
// مثال: ۱۶ میلی‌متر.
male_length = 16;

// قطر بیرونی قسمت نری.
// مثال: ۱۹.۲ میلی‌متر (کمی باریک‌تر از بدنهٔ ۲۲ میلی‌متری).
male_outer_diameter = 19.2;

// لقی بین نری و مادگی.
// مثال: ۰.۲۵ میلی‌متر از هر طرف → قطر داخلی مادگی ۰.۵ میلی‌متر بزرگ‌تر از نری.
// اگر پس از چاپ اتصال سفت بود، این را به ۰.۳ تا ۰.۴ افزایش دهید.
joint_clearance = 0.25;

// قطر داخلی مادگی (خودکار محاسبه می‌شود).
// مثال: ۱۹.۲ + ۲×۰.۲۵ = ۱۹.۷ میلی‌متر.
female_inner_diameter = male_outer_diameter + 2*joint_clearance;

// فعال/غیرفعال کردن سیستم قفل ضربه‌ای.
// true = یک برجستگی کوچک روی نری و شیار متناظر در مادگی.
snap_fit = true;

// ارتفاع برجستگی قفل.
// مثال: ۰.۲۵ میلی‌متر. اگر اتصال شل بود، به ۰.۳ تا ۰.۴ افزایش دهید.
snap_height = 0.25;

// عرض برجستگی قفل (در راستای محور لوله).
// مثال: ۱.۵ میلی‌متر.
snap_width = 1.5;

// عرض شیار نگهدارنده در مادگی.
// مثال: ۲ میلی‌متر (کمی پهن‌تر از برجستگی ۱.۵).
groove_width = 2;

// فاصلهٔ شیار از دهانهٔ مادگی.
// مثال: ۲ میلی‌متر.
groove_position = 2;

// فعال/غیرفعال کردن شیارهای انعطاف نری.
// true = نری به چند تیغهٔ باریک تقسیم می‌شود تا راحت‌تر وارد مادگی شود.
snap_slots = true;

// عرض هر شیار.
// مثال: ۰.۸ میلی‌متر. اگر چاپگرتان رزولوشن پایینی دارد، به ۱.۰ افزایش دهید.
slot_width = 0.8;

// تعداد شیارهای دور نری.
// مثال: ۴ شیار (هر ۹۰ درجه).
slot_count = 4;

// فاصلهٔ انتهای هر شیار از نوک نری.
// مثال: ۳ میلی‌متر — نوک نری یکپارچه و نشکن می‌ماند.
slot_end_margin = 3;


// =======================================================
// ۴. سوراخ‌های انگشتی (کوک سل)
// =======================================================

// قطر سوراخ‌های انگشتی.
// مثال: ۷ میلی‌متر استاندارد نی هفت‌بند ایرانی است.
// بزرگ‌تر (مثلاً ۸) → بم‌تر؛ کوچک‌تر (مثلاً ۶) → زیرتر.
hole_diameter = 7;

// مقدار اضافی برش به سمت داخل دیواره.
// مثال: ۲ میلی‌متر تضمین می‌کند سوراخ کاملاً از دیواره عبور کند.
// اگر پس از چاپ سوراخ کاملاً باز نشده بود، به ۳ تا ۴ افزایش دهید.
hole_cut_extra = 2.0;

// موقعیت سوراخ‌های جلو از دهانه (z=0).
// ترتیب آرایه: از نزدیک‌ترین به دهانه تا دورترین.
// فاصله درون هر گروه دست: ۲۵ تا ۲۸ میلی‌متر.
// فاصله بین دو گروه دست: ۴۵ میلی‌متر.
// چیدمان (از دهانه به سمت انتهای باز):
//   سوراخ شست در ۱۰۵
//   گروه دست بالا:  ۱۳۰، ۱۵۷، ۱۸۵
//   گروه دست پایین: ۲۳۰، ۲۵۵
front_holes = [
    130,   // سوراخ ۱ — اولین انگشت دست بالا
    157,   // سوراخ ۲ — +۲۷ میلی‌متر
    185,   // سوراخ ۳ — +۲۸ میلی‌متر
    230,   // سوراخ ۴ — اولین انگشت دست پایین (+۴۵ میلی‌متر)
    255    // سوراخ ۵ — +۲۵ میلی‌متر
];

// موقعیت سوراخ شست از دهانه.
// باید از همهٔ سوراخ‌های جلو به دهانه نزدیک‌تر باشد.
// مثال: ۱۰۵ میلی‌متر — ۲۵ میلی‌متر بالاتر از اولین سوراخ جلو.
back_hole = 105;


// =======================================================
// ۵. دهانه
// =======================================================

// قطر داخلی نهایی دهانه (پس از پوشش پلاستیکی).
// مثال: ۱۰ میلی‌متر.
mouthpiece_start_id = 10;

// طول ناحیهٔ مخروطی از دهانه تا حفرهٔ اصلی.
// مثال: ۳۰ میلی‌متر. بلندتر → صدای نرم‌تر؛ کوتاه‌تر → صدای تیزتر.
mouthpiece_cone_length = 30;

// ضخامت پوشش پلاستیکی (نوار تفلون یا شیلنگ سیلیکونی).
// مثال: ۰.۳ میلی‌متر. برای محافظت از لب و جلوگیری از خیس شدن.
plastic_wrap_thickness = 0.3;

// جبران ضخامت پوشش در طراحی CAD.
// true = قطر دهانهٔ CAD بزرگ‌تر ساخته می‌شود تا پس از پوشش، قطر نهایی دقیقاً ۱۰ شود.
compensate_for_wrap = true;

// قطر واقعی دهانه در فایل CAD (خودکار محاسبه می‌شود).
// مثال: ۱۰ + ۲×۰.۳ = ۱۰.۶ میلی‌متر.
mouthpiece_bare_id = mouthpiece_start_id + (compensate_for_wrap ? 2*plastic_wrap_thickness : 0);

// عرض بریدگی روی دهانه.
// مثال: ۹ میلی‌متر — محل قرارگیری لب نوازنده.
mouthpiece_notch_width = 9;

// عمق بریدگی دهانه.
// مثال: ۳ میلی‌متر.
mouthpiece_notch_depth = 3;


/* =========================================
   هندسهٔ مخروطی انتهای باز
   ========================================= */

// فعال کردن مخروط بیرونی در انتهای باز.
// true = قطر بیرونی در ۲۵ میلی‌متر آخر از ۲۲ به ۱۸ کاهش می‌یابد.
lower_outer_conical = true;

// فعال کردن مخروط داخلی در انتهای باز.
// true = قطر داخلی در ۲۵ میلی‌متر آخر از ۱۶ به ۱۲ کاهش می‌یابد.
lower_inner_conical = true;

// طول ناحیهٔ مخروطی.
// مثال: ۲۵ میلی‌متر.
lower_cone_length = 25;

// قطر بیرونی در انتهای باز.
// مثال: ۱۸ میلی‌متر.
lower_end_outer_diameter = 18;

// قطر داخلی در انتهای باز.
// مثال: ۱۲ میلی‌متر.
lower_end_inner_diameter = 12;

// تعداد پاره‌خط‌های مخروط (برای پیاده‌سازی منحنی در آینده رزرو شده).
lower_cone_segments = 40;


// =======================================================
// ۶. نمایش و بازرسی
// =======================================================

// 0 = نمایش همهٔ ۷ قطعه در کنار هم (چیدمان چاپ)
// 1 تا 7 = نمایش فقط همان قطعه
part_number = 0;

// false = قطعات جداگانه (برای چاپ)
// true = ساز مونتاژشده (برای بازرسی)
assembly_view = false;

// فعال کردن نمای نیمه‌برش (برای مشاهدهٔ داخل ساز).
cross_section_view = false;

// 0 = حذف نیمهٔ مثبت X
// 1 = حذف نیمهٔ منفی X
cross_section_side = 0;

// برای برش بازرسی در آینده رزرو شده است.
inspection_extra = 1;


// =======================================================
// ۷. حفرهٔ داخلی
// =======================================================
// حفرهٔ داخلی هر قطعه را می‌سازد.
// قطعهٔ ۱: دهانهٔ مخروطی + حفرهٔ استوانه‌ای.
// قطعهٔ ۷: حفرهٔ استوانه‌ای + مخروط انتهایی.
// بقیه: حفرهٔ استوانه‌ای.

module main_bore(n) {
    if (n == 1) {
        cylinder(h=mouthpiece_cone_length, d1=mouthpiece_bare_id, d2=inner_diameter);
        translate([0,0,mouthpiece_cone_length])
            cylinder(h=part_length - mouthpiece_cone_length + 1, d=inner_diameter);
    }
    else if (n == number_of_parts && lower_inner_conical) {
        // حفرهٔ استوانه‌ای تا شروع مخروط
        translate([0,0,-male_length-1])
            cylinder(h=(part_length - lower_cone_length) + male_length + 2, d=inner_diameter);
        // حفرهٔ مخروطی در انتهای باز
        translate([0,0,part_length - lower_cone_length - 0.1])
            cylinder(h=lower_cone_length + 0.2, d1=inner_diameter, d2=lower_end_inner_diameter);
    }
    else {
        translate([0,0,-male_length-1])
            cylinder(h=part_length+male_length+2, d=inner_diameter);
    }
}


// =======================================================
// ۸. گرهٔ داخلی بامبو
// =======================================================
// یک گرهٔ توپر با حفرهٔ باریک میانی می‌سازد.
// سطح بیرونی گره با دیوارهٔ داخلی لوله هم‌سطح است.

module internal_node(z) {
    translate([0, 0, z-band_taper_length])
    difference() {
        // استوانهٔ توپر گره
        cylinder(h=band_width+2*band_taper_length, d=inner_diameter);
        // حفرهٔ باریک با شیب‌های ورودی و خروجی
        union() {
            cylinder(h=band_taper_length, d=inner_diameter);
            translate([0,0,band_taper_length])
                cylinder(h=band_taper_length, d1=inner_diameter, d2=band_bore_diameter);
            translate([0,0,2*band_taper_length])
                cylinder(h=band_width, d=band_bore_diameter);
            translate([0,0,2*band_taper_length+band_width])
                cylinder(h=band_taper_length, d1=band_bore_diameter, d2=inner_diameter);
        }
    }
}


// =======================================================
// ۹. قرار دادن گره‌ها در هر قطعه
// =======================================================
// فقط گره‌هایی را رسم می‌کند که کاملاً داخل قطعهٔ n قرار می‌گیرند.

module section_nodes(n) {
    z_start = (n-1)*part_length;
    z_end = n*part_length;
    for (z = band_positions) {
        if (z-band_taper_length >= z_start && z+band_width+band_taper_length <= z_end) {
            internal_node(z-z_start);
        }
    }
}


// =======================================================
// ۱۰. بدنه و اتصالات
// =======================================================

module connector_outer(n) {
    difference() {
        union() {
            // بدنهٔ اصلی (با مخروط انتهایی برای قطعهٔ آخر)
            if (n == number_of_parts && lower_outer_conical) {
                cylinder(h=part_length - lower_cone_length, d=outer_diameter);
                translate([0,0,part_length - lower_cone_length])
                    cylinder(h=lower_cone_length, d1=outer_diameter, d2=lower_end_outer_diameter);
            } else {
                cylinder(h=part_length, d=outer_diameter);
            }

            // نری (قطعات ۲ تا ۷)
            if (n > 1) {
                translate([0,0,-male_length])
                    cylinder(h=male_length, d=male_outer_diameter);
                if (snap_fit) {
                    translate([0,0,-male_length+2])
                        cylinder(h=snap_width, d=male_outer_diameter+2*snap_height);
                }
            }
        }

        // مادگی (قطعات ۱ تا ۶)
        if (n < number_of_parts) {
            translate([0,0,part_length-male_length])
                cylinder(h=male_length+0.1, d=female_inner_diameter);
            if (snap_fit) {
                translate([0,0,part_length-male_length+groove_position])
                    cylinder(h=groove_width, d=female_inner_diameter+2*snap_height);
            }
        }

        // شیارهای انعطاف نری (قطعات ۲ تا ۷)
        if (n > 1 && snap_fit && snap_slots) {
            for (a = [0:360/slot_count:359]) {
                rotate([0,0,a])
                    translate([-slot_width/2, 0, -male_length])
                        cube([slot_width, male_outer_diameter/2+1, male_length-slot_end_margin]);
            }
        }

        // حفرهٔ داخلی
        main_bore(n);

        // بریدگی دهانه (فقط قطعهٔ ۱)
        if (n == 1) {
            translate([-mouthpiece_notch_width/2, -ro-1, 0])
                cube([mouthpiece_notch_width, ro+2, mouthpiece_notch_depth]);
        }
    }
}


// =======================================================
// ۱۱. سوراخ‌های انگشتی (با تشخیص همپوشانی)
// =======================================================
// همپوشانی واقعی دایرهٔ سوراخ با هر ناحیه را بررسی می‌کند (نه فقط مرکز)،
// تا اگر سوراخ روی اتصال قرار گرفت، در هر دو طرف بریده شود.

module finger_holes(n) {
    z_start = (n-1)*part_length;
    z_end   = z_start + part_length;
    cutter_depth = wall + 2*hole_cut_extra;
    hr = hole_diameter / 2;

    // سوراخ‌های جلو
    for (z = front_holes) {
        in_main = (z + hr > z_start) && (z - hr < z_end);
        in_male = (n > 1) && (z + hr > z_start - male_length) && (z - hr < z_start);
        if (in_main || in_male) {
            translate([0, -ro - hole_cut_extra, z - z_start])
                rotate([-90, 0, 0])
                    cylinder(h=cutter_depth, d=hole_diameter, center=false);
        }
    }

    // سوراخ شست
    in_main = (back_hole + hr > z_start) && (back_hole - hr < z_end);
    in_male = (n > 1) && (back_hole + hr > z_start - male_length) && (back_hole - hr < z_start);
    if (in_main || in_male) {
        translate([0, ro + hole_cut_extra, back_hole - z_start])
            rotate([90, 0, 0])
                cylinder(h=cutter_depth, d=hole_diameter, center=false);
    }
}


// =======================================================
// ۱۲. قطعهٔ کامل
// =======================================================

module ney_section(n) {
    difference() {
        union() {
            connector_outer(n);
            section_nodes(n);
        }
        finger_holes(n);
    }
}


// =======================================================
// ۱۳. برش بازرسی
// =======================================================

module inspection_cut() {
    if (cross_section_view) {
        difference() {
            children();
            if (cross_section_side == 0) {
                translate([0, -100, -100]) cube([100, 200, 1000]);
            } else {
                translate([-100, -100, -100]) cube([100, 200, 1000]);
            }
        }
    } else {
        children();
    }
}


// =======================================================
// ۱۴. نمایش یک قطعه
// =======================================================

if (part_number >= 1 && part_number <= number_of_parts) {
    inspection_cut() {
        translate([0,0,male_length])
            ney_section(part_number);
    }
}


// =======================================================
// ۱۵. چیدمان چاپ (همهٔ قطعات کنار هم)
// =======================================================

if (part_number == 0 && !assembly_view) {
    for (i = [1:number_of_parts]) {
        translate([(i-1)*(outer_diameter+12), 0, male_length])
            ney_section(i);
    }
}


// =======================================================
// ۱۶. ساز مونتاژشده
// =======================================================

if (assembly_view) {
    inspection_cut() {
        union() {
            for (i = [1:number_of_parts]) {
                translate([0, 0, (i-1)*part_length])
                    ney_section(i);
            }
        }
    }
}